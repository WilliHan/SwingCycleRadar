# KRX 웹 세션 (krx_direct) — SwingCycle_Radar_Source_Level_Design_v1.1.md 6.2
# 주의: KRX_ID / KRX_PW (KRX_WEB_ID와 다름)는 여기서 절대 설정하지 않는다.
# pykrx 패키지가 모듈 import 시점에 KRX_ID/KRX_PW를 읽어 자체적으로(우리 로그인
# 조율 락과 무관하게) 즉시 로그인을 시도한다 — sugup-report의 2026-08-04 IP 차단
# 사고와 같은 유형의 위험. KRX_WEB_ID/PASSWORD만 쓰고 KRX_ID/KRX_PW는 미설정 유지.
KRX_WEB_ID=
KRX_WEB_PASSWORD=
KRX_WEB_LOGIN_ENABLED=true
KRX_LOGIN_CD003_MAX_RETRY=3
KRX_LOGIN_CD003_BACKOFF_BASE=1.0
KRX_LOGIN_MIN_INTERVAL_SEC=300
KRX_LOGIN_SHARED_STATE_PATH=~/.krx_shared/login_state.json

# 로컬 DB
DB_PATH=./data/swingcycle.db
LOG_LEVEL=INFO
HTTP_TIMEOUT_SEC=20
HTTP_MAX_RETRIES=3

# Supabase (절친종목 유니버스 원본) — SwingCycle_Radar_MoneyFlowHub_Integration_Design_v0.2.md 6.2
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Hub 연동 (로컬 dev 신원 확인 브리지) — 통합 설계서 4.4
MFGR_URL=http://localhost:8503
